      $('drawer-title').textContent=moduleInfo?(item?'Edit module':'Add module'):(item?'Edit ':'Add ')+collection.slice(0,-(collection.endsWith('s')?1:0)).toLowerCase();
      const fields=moduleInfo?[['name','Module name',item?.name||'','text'],['lessons','Lessons (one per line)',item?.lessons?.join('\n')||'','textarea'],['status','Status',item?.status||'In progress','select']]:collection==='Courses'?[['name','Course name',item?.name||'','text'],['detail','Course code',item?.code||'','text'],['group','Department',item?.department||'','text'],['status','Status',item?.status||'Active','select']]:[['name','Name',item?.name||'','text'],['detail','Details',item?.detail||'','text'],['group','Group / value',item?.group||'','text'],['status','Status',item?.status||'Active','select']];
      $('form-fields').innerHTML=fields.map(([key,label,value,type])=>`<div><label for="field-${key}" class="block font-bold text-sm mb-2">${label}</label>${type==='textarea'?`<textarea id="field-${key}" name="${key}" class="field min-h-32" required>${esc(value)}</textarea>`:type==='select'?`<select id="field-${key}" name="${key}" class="field">${[...new Set([value,'Active','Inactive','Open','Closed','Published','Draft','Present','Absent','Enabled','Disabled','Available','In progress','Complete'])].map(o=>`<option ${o===value?'selected':''}>${esc(o)}</option>`).join('')}</select>`:`<input id="field-${key}" name="${key}" class="field" value="${esc(value)}" required maxlength="120">`}</div>`).join('');
      $('form-error').classList.add('hidden');$('drawer-back').classList.remove('hidden');$('field-name').focus();refreshIcons();
    }
    function closeDrawer(){$('drawer-back').classList.add('hidden');editing=null}
    document.addEventListener('DOMContentLoaded',()=>{
      document.querySelectorAll('[data-role]').forEach(b=>b.addEventListener('click',()=>enter(b.dataset.role)));
      $('role-switch').addEventListener('change',e=>enter(e.target.value));
      $('back-home').addEventListener('click',goHome);
      $('open-menu').addEventListener('click',()=>{$('sidebar').classList.add('open');$('mobile-shade').classList.remove('hidden')});
      $('close-menu').addEventListener('click',closeMenu);$('mobile-shade').addEventListener('click',closeMenu);
      $('close-drawer').addEventListener('click',closeDrawer);$('cancel-form').addEventListener('click',closeDrawer);
      $('drawer-back').addEventListener('click',e=>{if(e.target===$('drawer-back'))closeDrawer()});
      document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeDrawer();closeMenu()}});
      document.addEventListener('click',e=>{
        const nav=e.target.closest('[data-nav]');if(nav){navigate(nav.dataset.nav);return}
        const course=e.target.closest('[data-course]');if(course){const c=courses.find(x=>x.id===Number(course.dataset.course));if(c&&(role!=='student'&&role!=='teacher'||c.id<=2)){selectedCourse=c;view='Courses';render();window.scrollTo({top:0,behavior:'smooth'})}return}
        const add=e.target.closest('[data-add]');if(add){openDrawer(add.dataset.add);return}
        const moduleAdd=e.target.closest('[data-add-module]');if(moduleAdd){openDrawer('Modules',null,[Number(moduleAdd.dataset.addModule),null]);return}
        const moduleEdit=e.target.closest('[data-edit-module]');if(moduleEdit){const [cid,idx]=moduleEdit.dataset.editModule.split(':').map(Number);openDrawer('Modules',null,[cid,idx]);return}
        const edit=e.target.closest('[data-edit]');if(edit){openDrawer(view,Number(edit.dataset.edit));return}
        const status=e.target.closest('[data-status]');if(status){const item=(records[view]||[]).find(x=>x.id===Number(status.dataset.status));if(item){item.status=['Inactive','Closed','Disabled','Absent','Draft'].includes(item.status)?'Active':'Inactive';renderAndPaint();notice(`${item.name}: status changed in demo.`)}}
      });
      $('content').addEventListener('input',e=>{if(e.target.id==='search-records'){filter=e.target.value;paintRows()}});
      $('content').addEventListener('change',e=>{if(e.target.id==='status-filter'){statusFilter=e.target.value;paintRows()}});
      $('edit-form').addEventListener('submit',e=>{
        e.preventDefault();const button=e.submitter;const values=Object.fromEntries(new FormData(e.currentTarget));
        if(Object.values(values).some(v=>!String(v).trim())){$('form-error').textContent='Complete every field before saving.';$('form-error').classList.remove('hidden');return}
        button.disabled=true;
        if(editing.moduleInfo){const [cid,idx]=editing.moduleInfo;const item={name:values.name.trim(),lessons:values.lessons.split('\n').map(x=>x.trim()).filter(Boolean),status:values.status};if(idx===null)modules[cid].push(item);else modules[cid][idx]=item}
        else if(editing.collection==='Courses'){let item=courses.find(x=>x.id===editing.id);if(!item){item={id:nextId++,progress:0,students:0,teacher:'Unassigned'};courses.push(item);modules[item.id]=[]}Object.assign(item,{name:values.name.trim(),code:values.detail.trim(),department:values.group.trim(),status:values.status})}
        else{let list=records[editing.collection];let item=list.find(x=>x.id===editing.id);if(!item){item={id:nextId++};list.push(item)}Object.assign(item,{name:values.name.trim(),detail:values.detail.trim(),group:values.group.trim(),status:values.status})}
        closeDrawer();renderAndPaint();notice('Demo changes saved for this session.');button.disabled=false;
      });
      refreshIcons();
    });
  </script>
 
</body></html>
