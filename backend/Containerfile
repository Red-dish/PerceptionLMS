# Lambda container image for the API. Build with Podman from the backend folder:
#   podman build --platform linux/amd64 --format docker -t perception-lms-api .
# scripts/deploy.py builds, pushes and deploys it for you.

FROM public.ecr.aws/lambda/python:3.14

# Install the exact versions from uv.lock. uv is only mounted for this step, so it is not in the image.
COPY pyproject.toml uv.lock /tmp/build/
RUN --mount=from=ghcr.io/astral-sh/uv:0.9.28,source=/uv,target=/bin/uv \
    cd /tmp/build \
    && uv export --frozen --no-dev --no-hashes --no-emit-project -o requirements.txt \
    && uv pip install --no-cache --python /var/lang/bin/python3 --target "${LAMBDA_TASK_ROOT}" -r requirements.txt \
    && rm -rf /tmp/build

COPY app ${LAMBDA_TASK_ROOT}/app

CMD ["app.main.handler"]
