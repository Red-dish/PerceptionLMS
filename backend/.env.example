# This is an example of a .env file for local development (.env is git-ignored).
# The AWS values point at the local stand-in container, not real AWS.
# Use 127.0.0.1, not localhost: on Windows, localhost can resolve to IPv6 (::1),
# which Podman's port forwarding does not serve, and boto3 then fails to connect.
AWS_ENDPOINT_URL=http://127.0.0.1:5000
AWS_DEFAULT_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
TABLE_NAME=perception-lms-local
BUCKET_NAME=perception-lms-local-files

# From Google Cloud console > APIs & Services > Credentials (OAuth client ID, type "Web application").
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Any random string of 32 or more characters. Never reuse the deployed one.
JWT_SECRET=replace-with-a-long-random-string-32-chars-min
# Your Google email, so you become the first admin when you sign in.
ADMIN_EMAILS=you@example.com
ALLOWED_ORIGINS=http://localhost:5173
# Optional: only allow Google Workspace accounts from this domain.
ALLOWED_DOMAIN=
