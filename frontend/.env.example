# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Both values end up in the public website, so never put a secret in a VITE_ variable.

# The API to talk to. Use http://localhost:8000 when running the backend locally.
VITE_API_URL=https://p4r5x8qd32.execute-api.ap-southeast-2.amazonaws.com

# The Google OAuth client ID, ending in .apps.googleusercontent.com. Ask Amora for it.
VITE_GOOGLE_CLIENT_ID=
